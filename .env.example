# Discord Application (from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Optional — plex.tv ACCOUNT token, used only for online "Discover" search detail
# lookups (movies/shows not in your library). The server PLEX_TOKEN above is a
# *server* token that the Plex cloud provider rejects, so without this, Discover
# results show but their detail pages have no description. Grab it from an
# app.plex.tv network request (the X-Plex-Token query param). Falls back to
# PLEX_TOKEN if unset.
PLEX_ACCOUNT_TOKEN=

# Optional — stable encryption secret for per-user Plex account links. Generate
# a long random value and keep it across deployments/backups. When unset,
# DISCORD_CLIENT_SECRET is used instead; changing that secret then requires
# users to relink Plex.
PLEX_LINK_SECRET=

# Server
PORT=3000

# Your public URL — must match the URL mapping in Discord Developer Portal
REDIRECT_URI=https://your-domain.example.com
ALLOWED_ORIGINS=https://your-domain.example.com

# Optional — restrict to specific Discord server(s), comma-separated
# Leave empty to allow all servers
ALLOWED_GUILD_IDS=

# Optional — password for one maintenance command, DELETE /api/plex/hls/sessions,
# which stops every stream the bot has running on Plex, in every room (other
# Plex apps' streams are left alone). It is for clearing streams stuck in Plex
# by hand; nothing calls it on its own, and the server already stops streams
# nobody is watching. Empty, it is accepted only from inside the container;
# set, also from anyone signed in who sends it in an X-Admin-Secret header.
# Most people can leave it empty.
ADMIN_SECRET=

# Optional — VPS relay for watch party segment delivery.
# When set, HLS segments route through the VPS instead of this server.
# Also disables P2P (VPS bandwidth makes it unnecessary).
# See docs/vps-relay-setup.md for full setup guide.
# VPS_RELAY_URL=https://theater.yourdomain.com
# VPS_RELAY_KEY=

# Optional — transcode bitrate tuning (kbps).
# Per-viewer bandwidth scales with this — lower it if home upload is tight,
# raise it for higher quality (VIDEO_BITRATE_KBPS is the average target,
# VIDEO_PEAK_BITRATE_KBPS bounds spikes).
# VIDEO_BITRATE_KBPS=12000
# VIDEO_PEAK_BITRATE_KBPS=20000

# Optional — HEVC transcodes. 1 lets Plex re-encode to HEVC instead of H.264
# for players that can decode it, which looks noticeably better at the same
# bitrate. Needs Plex Pass, hardware encoding (Intel or NVIDIA) and "Enable HEVC
# video encoding" in Plex's transcoder settings; without those Plex just keeps
# sending H.264. Decided per viewer: anyone whose player can't decode HEVC
# (Discord in Firefox, for one) gets an H.264 stream of their own, and everyone
# else stays on HEVC — the host included. On unless set to 0.
# HEVC_TRANSCODE=0

# Optional — Direct Stream. 1 lets Plex copy the video instead of re-encoding
# it whenever the player can decode it: H.264 always, HEVC (including 10-bit)
# when the player says it can. The picture is the original, usually at a
# fraction of a transcode's bitrate. Audio is still converted to AAC where it
# has to be. Picture subtitles (PGS, VobSub), codecs a player can't play,
# open-GOP Blu-ray H.264 and files averaging over DIRECT_STREAM_MAX_KBPS are
# re-encoded as before. Text subtitles are drawn by each player, so they never
# stop a copy. Decided per viewer, like HEVC above: someone who can't play the
# copy gets a re-encode of their own, and nobody else loses the original.
# On unless set to 0.
# DIRECT_STREAM=0

# Optional — the highest *average* bitrate (kbps) a file may have and still be
# copied; files averaging more are re-encoded at VIDEO_BITRATE_KBPS. Unset, it
# is VIDEO_BITRATE_KBPS itself. Peaks don't count: a film averaging 18 Mbps that
# runs past 60 for a few seconds is copied under a 20000 limit, and the
# players' buffers carry the peaks. A copy is the file's own bitrate, and every
# viewer pulls it from this server: a 30 Mbps remux for two people is up to
# 60 Mbps of upload (players on one stream share segments with each other once
# their buffers are full, which helps, but don't count on it). Keep it under
# your upload divided by how many usually watch. A viewer can still pick a lower
# quality for themselves in the player.
#
# Plex counts the bot as a remote player unless its network is listed under
# Settings → Network → LAN Networks, and then also holds its streams to your
# remote-streaming limits. Plex's log says "(WAN)" next to the bot's requests
# when that is happening.
# DIRECT_STREAM_MAX_KBPS=20000

# Optional — how the server keeps the films being played, so going back plays
# from here rather than loading again. A copied film (Direct Stream) is kept
# until its stream ends: in memory up to DIRECT_STREAM_MEMORY_MB for every
# stream together (default 6144, 6 GB), and the rest on disk in
# STREAM_CACHE_DIR (default: stream-cache in the data folder), with no limit
# but the disk — a copy is the file's own bitrate, up to 13.5 GB an hour for a
# 30 Mbps Blu-ray. Point STREAM_CACHE_DIR at an SSD, and mount it into the
# container (see the commented volume in docker-compose.yml). Each stream's
# folder is deleted when it ends, and the whole folder when the server starts.
# Re-encoded films keep TRANSCODE_CACHE_MB in memory, for every re-encode
# together (default 2048); Plex keeps the rest on its disk. On a server short
# of memory, lower both: the defaults can reach 8 GB while films play.
# DIRECT_STREAM_MEMORY_MB=6144
# STREAM_CACHE_DIR=/cache/stream
# TRANSCODE_CACHE_MB=2048

# Optional — the playback engine. plex (the default) has Plex make every stream,
# as above. ffmpeg makes them in this container instead, from the files
# themselves, under the same rules: a copy of the original picture when the
# player can decode it (H.264, and HEVC with its HDR and Dolby Vision 7/8), and
# otherwise a re-encode — HEVC Main10 or H.264 on the GPU (Intel Quick Sync,
# VAAPI or NVIDIA NVENC), or H.264 on the CPU without one — at about the bitrate
# the source's picture needs. Each stream's whole film is made ahead and kept
# until it ends, so seeks land at once. It also re-encodes Dolby Vision 5 with
# the right colours, which Plex copies as purple and green (on the GPU, where
# OpenCL works), burns in every kind of subtitle, and makes seek-bar previews
# for files Plex has none for. Whatever it can't make — Dolby Vision 5 without
# OpenCL, every re-encode slot taken, a file that isn't the one Plex has, a
# title that keeps failing — is left to Plex, stream by stream. Stats for nerds
# (I) says which engine made a stream, and why Plex did.
#
# It needs, in docker-compose.yml: the library mounted read-only, at the path
# Plex has it or mapped with MEDIA_PATH_MAP (without it, ffmpeg reads each file
# from Plex over the network, which works but seeks slower), /dev/dri under
# `devices` for Intel or AMD (or NVIDIA's runtime), and room in STREAM_CACHE_DIR
# for each stream's film: a copy the file's size, a 1080p re-encode 4 to 8 GB.
# The startup [Config] lines say what it found, the library's paths included.
# PLAYBACK_ENGINE=ffmpeg
#
# "plex path=>path here", comma-separated, when the library is mounted here at
# other paths than Plex's own.
# MEDIA_PATH_MAP=/media/movies=>/data/media/movies,/media/tv=>/data/media/tv
#
# auto (the default) tries a short encode on Intel's Quick Sync at startup, then
# VAAPI on the same render node, and uses the first that works; qsv, vaapi or
# nvenc try only that; none always uses the CPU. A render node that isn't there
# at startup is looked for again before each re-encode. FFMPEG_HWACCEL_DEVICE
# is the render node (or NVENC's GPU number). FFMPEG_HW_DECODE=off leaves the
# decoding to the CPU, for a GPU that fails on some files.
# FFMPEG_HWACCEL=auto
# FFMPEG_HWACCEL_DEVICE=/dev/dri/renderD128
# FFMPEG_HW_DECODE=on
#
# Re-encodes at once; past it, Plex makes the stream. Copies don't count.
# Default 6 on the GPU, 2 on the CPU.
# FFMPEG_MAX_ENCODES=6
#
# The encoder's speed against quality: ultrafast to veryslow, as x264 names
# them. Empty: faster on the CPU, medium on Quick Sync, p4 on NVENC.
# FFMPEG_PRESET=
#
# Empty (the default): each stream's whole film is made ahead, flat out. Seconds:
# each run is held that far ahead of the room instead — less disk and GPU,
# slower seeks past it.
# FFMPEG_LOOKAHEAD=
#
# 6: a surround track the player can't play becomes 5.1 AAC, not stereo.
# FFMPEG_AUDIO_CHANNELS=2
#
# Text subtitles inside a film read out of the file here, and ones beside it off
# the mount, rather than by Plex. off leaves them to Plex.
# FFMPEG_SUBTITLES=on
#
# Seek-bar previews made here for files Plex has none for, the first time the
# title is opened, kept in the data folder up to FFMPEG_PREVIEWS_MAX_GB.
# FFMPEG_PREVIEWS=on
# FFMPEG_PREVIEWS_MAX_GB=20
#
# Memory for the segments rooms are fetching now, so a room's viewers are sent
# the same one without reading the disk. 0 reads every one from disk.
# FFMPEG_SEGMENT_MEMORY_MB=512
#
# off: a stream ffmpeg can't make fails to start, saying why, rather than going
# to Plex. For testing.
# FFMPEG_FALLBACK_TO_PLEX=on
#
# With Plex making the streams (PLAYBACK_ENGINE unset), an AV1 file's are still
# made here: copied for a player that decodes AV1, re-encoded for one that
# doesn't (on the GPU when one is mapped in, else the CPU). Plex can't copy AV1,
# so it re-encodes every AV1 file, and on some servers its re-encode comes out
# as flickering purple boxes. off leaves AV1 files to Plex too.
# FFMPEG_FOR_AV1=on
#
# keep (the default): a re-encode for a player that decodes HEVC stays HDR, so
# it looks like the copy, only softer, when the player's screen is showing HDR.
# On a screen in SDR (Windows runs HDR monitors in SDR unless HDR is switched
# on) it is mapped to SDR here, as Plex does: the browser's own mapping is
# dimmer. tonemap maps every re-encode to SDR.
# H.264 streams, burned-in subtitles and Dolby Vision 5 are always
# mapped to SDR; FFMPEG_TONEMAP is the curve: reinhard (default), mobius, hable,
# bt2390, linear, gamma or clip.
# FFMPEG_HDR_REENCODE=keep
# FFMPEG_TONEMAP=reinhard
#
# Plex can't see what ffmpeg plays, so the server tells it: the stream shows in
# Plex's dashboard, Tautulli and Tracearr as "Plex Discord Theater", under
# PLEX_TOKEN's account, and watch progress is kept as in Plex mode. Plex labels
# it Direct Play at the file's own bitrate, and can't stop it (stop it from the
# activity). On unless set to 0.
# FFMPEG_REPORT_TO_PLEX=1
#
# Another ffmpeg than the image's own (Jellyfin's build), and its ffprobe (the
# one beside it unless set).
# FFMPEG_PATH=
# FFPROBE_PATH=

# Optional — reading subtitles ahead. The server has Plex read a title's text
# subtitles out of the file before anyone picks them — up to three: the one a
# viewer would start on, and others in its language — so switching to one is
# instant. Each read is Plex going through the whole file, so on slow disks 0
# saves that work, and a subtitle inside the file is read when it is first
# chosen instead (a wait while Plex reads it). On unless set to 0.
# SUBTITLE_PREFETCH=0

# Optional — thumbnail cache tuning
# THUMB_CACHE_TTL_MS=7776000000   # 90 days
# THUMB_CACHE_MAX_SIZE=10G        # any size with a unit: 500M, 50G, 2T
#                                 # (THUMB_CACHE_MAX_MB, the older setting, is still read)

# Optional — TMDB API key. Powers two detail-page rows:
#  - "also in this collection": the whole TMDB franchise for a movie, with films
#    you don't own marked "Not in library" (requestable when Seerr is set).
#    Without a key this row still appears but lists only films already owned.
#  - "More Like This": TMDB's "you might also like" suggestions for a movie/show,
#    owned titles first, then requestable ones. Hidden without a key.
# Grab a free v3 key from https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Optional — TheTVDB API key, used for one thing: the list of episodes a season
# is supposed to contain, which drives the missing / not-yet-aired rows inside a
# season.
#
# It matters because TVDB is what Sonarr monitors, and TVDB and TMDB do not
# always agree about which season an episode belongs to. With only a TMDB key
# the list is still shown, but on a show where the two disagree it can name
# episodes that actually sit in a different season — and requesting them
# achieves nothing, because Sonarr numbers them the other way.
#
# Free key from https://thetvdb.com/api-information (a "project" key needs no
# PIN; a user-supported subscriber key does, and goes in TVDB_PIN).
# TVDB_API_KEY=
# TVDB_PIN=

# Optional — Seerr (Overseerr / Jellyseerr) integration for requesting titles
# that aren't in your library, from the Discover detail page. Set SEERR_URL to
# enable the Request button (left unset, it's hidden). Requests are made as YOUR
# Seerr account by signing in with PLEX_ACCOUNT_TOKEN (above) — no API key needed.
# SEERR_URL=https://requests.yourdomain.com

# Optional — diagnostic logging. Everything the server logs is written to
# <data>/logs/theater-YYYY-MM-DD.log, and connected clients ship their player
# events into the same file, so a stream that dies can be reconstructed after
# the container logs have rolled away. Plex and session tokens are redacted.
# Copy them off with: docker cp plex-discord-theater:/data/logs ./logs
# LOG_TO_FILE=0 turns the file sink off (console only).
# LOG_TO_FILE=1
# LOG_DIR=/app/data/logs
# LOG_RETENTION_DAYS=7
# LOG_MAX_FILE_MB=64

# Optional — verbose per-request logging: a line for every HLS segment fetched,
# every keep-alive ping and every prefetch poll. Useful while diagnosing a
# specific stream, and roughly five times the log volume the rest of the day —
# one evening's worth was 6,700 segment lines. Implied by NODE_ENV != production.
# DEBUG=1

# Optional — detail-page cache warming. The first enabled run pre-fetches what
# detail pages need (metadata, cast, collections and related titles) into the
# persistent /data cache. Later restarts reuse unchanged titles and refresh only
# items whose Plex updatedAt changed (plus a weekly freshness pass), so deploying
# does not rebuild the whole cache. A single catalog scan also supplies local
# recommendation ownership matching instead of per-title Plex searches.
# It then fetches the same titles' artwork (posters, backdrops, the first 12
# cast photos and the posters in their collection and "More Like This" rows)
# and every season and episode of their shows (each season's full episode list
# from TVDB or TMDB, details, season posters, episode stills and the first 12
# cast photos, guest stars included), at the sizes the pages ask for. Anything
# already cached is skipped, so only the first run takes long — several hours
# for a big library. Nothing is asked of Plex while a room is playing, and
# artwork stops for the pass once the image cache is 90% full.
# WARM_CACHE=0 turns it off entirely.
# WARM_CACHE=1
# WARM_CACHE_MAX_ITEMS=600      # titles to keep warm, newest first, or "all"
# WARM_CACHE_DELAY_MS=250       # pause after each request to Plex; raise it to tread lighter
# WARM_CACHE_INTERVAL_MIN=240   # how often to refresh the warmed set
# WARM_CACHE_ARTWORK=0          # leave artwork to load when a page first shows it
# WARM_CACHE_EPISODES=0         # skip seasons and episodes

# Private read-only integration with plex-qbt-manager. Use the same value as its THEATER_API_KEY.
# Leave empty to disable. Never expose this key in browser configuration.
QBT_MANAGER_API_KEY=
