# Discord Application (from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Optional — plex.tv ACCOUNT token, used only for online "Discover" search detail
# lookups (movies/shows not in your library). The server PLEX_TOKEN above is a
# *server* token that the Plex cloud provider rejects, so without this, Discover
# results show but their detail pages have no description. Grab it from an
# app.plex.tv network request (the X-Plex-Token query param). Falls back to
# PLEX_TOKEN if unset.
PLEX_ACCOUNT_TOKEN=

# Server
PORT=3000

# Your public URL — must match the URL mapping in Discord Developer Portal
REDIRECT_URI=https://your-domain.example.com
ALLOWED_ORIGINS=https://your-domain.example.com

# Optional — restrict to specific Discord server(s), comma-separated
# Leave empty to allow all servers
ALLOWED_GUILD_IDS=

# Optional — admin secret for /api/plex/hls/sessions endpoint
ADMIN_SECRET=

# Optional — VPS relay for watch party segment delivery.
# When set, HLS segments route through the VPS instead of this server.
# Also disables P2P (VPS bandwidth makes it unnecessary).
# See docs/vps-relay-setup.md for full setup guide.
# VPS_RELAY_URL=https://theater.yourdomain.com
# VPS_RELAY_KEY=

# Optional — transcode bitrate tuning (kbps).
# Per-viewer bandwidth scales with this — lower it if home upload is tight,
# raise it for higher quality (VIDEO_BITRATE_KBPS is the average target,
# VIDEO_PEAK_BITRATE_KBPS bounds spikes).
# VIDEO_BITRATE_KBPS=12000
# VIDEO_PEAK_BITRATE_KBPS=20000

# Optional — ffmpeg transcode tuning. Video is transcoded to HLS by this server's
# own ffmpeg (reading each file over Plex's direct-file URL), not by Plex. This
# moves transcode CPU load onto the app host.
#   FFMPEG_PATH            path to the ffmpeg binary (default: ffmpeg on PATH)
#   FFMPEG_PRESET          x264/qsv preset — faster preset = less CPU, larger
#                          files (default: veryfast; ignored by vaapi)
#   SEG_SECONDS            HLS segment length in seconds (default: 4)
#   MAX_TRANSCODE_SESSIONS max simultaneous encodes; each is one ~1080p encode, so
#                          this caps CPU across concurrent watch parties (default: 4)
#   HLS_TMP_DIR            where per-session segments are written
#                          (default: OS temp dir; the container sets /data/hls)
# FFMPEG_PATH=ffmpeg
# FFMPEG_PRESET=veryfast
# SEG_SECONDS=4
# MAX_TRANSCODE_SESSIONS=4
# HLS_TMP_DIR=/data/hls

# Optional — hardware-accelerated encoding (Intel QuickSync). Offloads the H.264
# encode to the GPU, cutting CPU dramatically for multiple concurrent streams.
# Decoding stays in software so subtitle burn-in keeps working.
#   HWACCEL=none    software libx264 (default; works everywhere)
#   HWACCEL=vaapi   QuickSync via VAAPI — the recommended Intel path on Linux
#   HWACCEL=qsv     QuickSync via Intel's native oneVPL/MediaSDK
# The container must be given the GPU (/dev/dri) — see docker-compose.yml for the
# devices + group_add lines to uncomment. HWACCEL_DEVICE is the render node.
# HWACCEL=vaapi
# HWACCEL_DEVICE=/dev/dri/renderD128
#
# Optional — also DECODE on the GPU (VAAPI only). By default only the H.264 encode
# runs on the GPU; the source is decoded in software. For a heavy 4K/HEVC source
# (e.g. Dolby Vision) that software decode can be near the realtime limit, so adding
# a burned-in subtitle tips it over and playback stutters. HWACCEL_DECODE=1 moves the
# decode onto the GPU too, giving the pipeline the headroom to burn subtitles
# smoothly. Off by default and opt-in because if the GPU can't decode a given input
# codec ffmpeg errors instead of falling back to software — so enable it and test
# your library. The [FFmpeg] session-created log shows decode=hw or decode=sw.
# HWACCEL_DECODE=1

# Optional — read media from a local mount instead of over Plex's HTTP URL.
# When the library is mounted into this container (read-only), ffmpeg reads files
# straight off disk, which is far faster than pulling them over HTTP — subtitle
# extraction that took ~20s drops to ~1s, and seeks are quicker too. It's
# auto-detected: if the file exists locally it's used, otherwise it falls back to
# the Plex HTTP URL (so this is safe to leave unset). The [FFmpeg] session-created
# log shows source=local or source=http.
#
# Mount the media in docker-compose.yml (see the commented volume there). If your
# mount path differs from the path PLEX reports (Part.file), set MEDIA_PATH_MAP to
# rewrite the prefix: comma-separated `plexPrefix=>localPrefix` pairs. Not needed
# if you mount the library at the same path Plex uses.
#   e.g. Plex sees /media/... and you mount it at /mnt/media:
# MEDIA_PATH_MAP=/media=>/mnt/media

# Optional — thumbnail cache tuning
# THUMB_CACHE_TTL_MS=604800000
# THUMB_CACHE_MAX_MB=500

# Optional — TMDB API key. Powers two detail-page rows:
#  - "also in this collection": the whole TMDB franchise for a movie, with films
#    you don't own marked "Not in library" (requestable when Seerr is set).
#    Without a key this row still appears but lists only films already owned.
#  - "More Like This": TMDB's "you might also like" suggestions for a movie/show,
#    owned titles first, then requestable ones. Hidden without a key.
# Grab a free v3 key from https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Optional — Seerr (Overseerr / Jellyseerr) integration for requesting titles
# that aren't in your library, from the Discover detail page. Set SEERR_URL to
# enable the Request button (left unset, it's hidden). Requests are made as YOUR
# Seerr account by signing in with PLEX_ACCOUNT_TOKEN (above) — no API key needed.
# SEERR_URL=https://requests.yourdomain.com

# Optional — external ratings on movie/show detail pages: IMDb, Rotten Tomatoes
# (both the critic Tomatometer and the Audience score) and TMDB. These come from
# MDBList (https://mdblist.com), a free aggregator — Rotten Tomatoes has no public
# API, so this is how the RT scores are obtained. Grab a free API key from
# https://mdblist.com/preferences (API Access). Left unset, the ratings row is
# simply hidden.
# MDBLIST_API_KEY=

# Optional — diagnostic logging. Everything the server logs is written to
# <data>/logs/theater-YYYY-MM-DD.log, and connected clients ship their player
# events into the same file, so a stream that dies can be reconstructed after
# the container logs have rolled away. Plex and session tokens are redacted.
# Copy them off with: docker cp plex-discord-theater:/data/logs ./logs
# LOG_TO_FILE=0 turns the file sink off (console only).
# LOG_TO_FILE=1
# LOG_DIR=/app/data/logs
# LOG_RETENTION_DAYS=7
# LOG_MAX_FILE_MB=64

# Optional — verbose per-request logging: a line for every HLS segment fetched,
# every keep-alive ping and every prefetch poll. Useful while diagnosing a
# specific stream, and roughly five times the log volume the rest of the day —
# one evening's worth was 6,700 segment lines. Implied by NODE_ENV != production.
# DEBUG=1

# Optional — detail-page cache warming. After startup the server walks the
# library in the background and pre-fetches what a detail page needs (metadata,
# cast, collections, related titles), so opening a title is a cache hit instead
# of several round trips to Plex and TMDB while the user waits on a skeleton.
# It is deliberately slow — one title at a time with a pause between them — so it
# stays off the critical path of the server that is also transcoding video.
# WARM_CACHE=0 turns it off entirely.
# WARM_CACHE=1
# WARM_CACHE_MAX_ITEMS=600      # titles to keep warm, newest first
# WARM_CACHE_DELAY_MS=250       # pause between titles; raise it to tread lighter
# WARM_CACHE_INTERVAL_MIN=240   # how often to refresh the warmed set
